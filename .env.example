# ==============================================================================
# ROBLOX OPEN CLOUD API CONFIGURATION
# ==============================================================================
# Salin file ini menjadi .env lalu isi API Key Anda dari Roblox Creator Hub:
# https://create.roblox.com/dashboard/credentials
#
# Izin API Key yang wajib diaktifkan:
# - Asset System: Read & Write (atau Permissions: Use / Manage)
# ==============================================================================

# Kunci Utama (Wajib):
ROBLOX_API_KEY=roblox_open_cloud_api_key_disini

# Kunci Tambahan / Multi-Akun (Opsional - jika aset diupload di beberapa akun):
# ROBLOX_API_KEY_2=kunci_akun_kedua_disini
# ROBLOX_API_KEY_3=kunci_akun_ketiga_disini
